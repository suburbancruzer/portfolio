{
  "_version": "1.12.0",
  "sap.app": {
    "id": "mosboeck.portfolio",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "i18n": "i18n/i18n.properties"
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true,
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "rootView": {
      "viewName": "mosboeck.portfolio.view.Main",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.uxap": {},
        "sap.ui.core": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "mosboeck.portfolio.i18n.i18n",
          "supportedLocales": ["", "de"],
          "fallbackLocale": ""
        }
      }
    }
  }
}
